  "doc_id": "publish-allowlist",
  "version": 2,
  "type": "data-config",
  "status": "active",
  "policy": "enforce",
  "default": "deny",
  "owner": "human",
  "created": "2026-11-19",
  "updated": "2026-11-25",
  "approved": "2026-11-24 用户批准学习站发布政策（审计整改 TASK 2；advisory 模式废除）",
  "note": "强制发布边界 v2：默认拒绝（default=deny），所有发布资产逐个登记，不放行整个目录。archive/ 依 D10.4 保留在离线站只读发布（offline-read-only：不进默认搜索与课程导航，不自动扩大为公开在线站点）；evidence/ 与 knowledge-model/ 为资产级精选登记（curated-data 嵌入 payload，excluded-internal 只登记不发布）。内部文档（DECISIONS/CHANGELOG/WORKFLOW_STATE/reviews/.agent/.governance/课程根审核材料）只登记不发布。未登记资产进入可发布空间 = build 与 validate 双双 FAIL。切换回 advisory 或批量放行目录需人工裁决。",
  "policies": {
    "public": {
      "nav": true,
      "search": true,
      "online": "allowed",
      "desc": "学习者可见"
    },
    "offline-read-only": {
      "nav": true,
      "search": false,
      "online": "forbidden",
      "badge": "历史归档 · 只读",
      "desc": "D10.4：archive/ 保留在离线站只读发布，与现行课程分离，不默认混入搜索，不扩大为公开在线站点"
    },
    "curated-data": {
      "nav": false,
      "search": false,
      "online": "allowed",
      "embed": true,
      "desc": "evidence/knowledge-model 资产级精选数据集（source-registry.json / concepts.json）。2026-11-25 起由 build_site 显式嵌入 payload.curated（经 require_site_data 强制校验，validate 核对嵌入集合与 SHA256）：每篇文档底部「证据与概念」面板只输出引用信息（来源标题/链接/类型/支撑的断言编号）与概念（ID/名称/路由/已登记关系），不输出断言验证状态（claim-ledger.json 为 excluded-internal，永不嵌入）。evidence/README.md 与 knowledge-model/README.md（public）继续说明证据层。"
    },
    "site-data": {
      "nav": false,
      "search": false,
      "online": "allowed",
      "desc": "站点运行数据（课程结构/术语/图/实验），非文档"
    },
    "excluded-internal": {
      "nav": false,
      "search": false,
      "online": "forbidden",
      "desc": "位于可发布空间但明确不发布的内部文件（登记原因见 reason）"
    }
  },
  "scan": {
    "md": "仓库根内全部 .md，除非位于非资产空间（publish_boundary.NON_ASSET_PARTS/FILES：.git/web/site-vitepress/node_modules/.agent/.workbuddy-ai/.zcode/.gemini/.cursor/.github/.governance/reviews 及根 CLAUDE.md/AGENTS.md）。空间内每个 .md 必须逐个登记，未登记 = build 与 validate 双双 FAIL。",
    "json": "仅 evidence/** 与 knowledge-model/**（资产级精选登记空间）。tools/*.json 与 courses/*/course.json 等站点数据由 build 显式加载并经 require_site_data 强制校验。",
    "site_data": "build_site 显式加载并嵌入 payload 的数据：tools/{course,glossary,graph,labs}.json + courses/*/course.json，策略必须为 site-data。"
  },
