{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KCR Stage 3 · review-decision（人工审核裁决）",
  "description": "D13 设计文档 §Stage3 的机器契约。**由人工填写**——AI 不预填、不自动升级 claim、不自动废弃（G1 性质关卡）。request_research 转 Category C 研究任务后回 Stage 1 重审。",
  "type": "object",
  "required": ["proposal_id", "reviewer", "date", "decisions", "overall"],
  "properties": {
    "proposal_id": { "type": "string", "pattern": "^KCR-\\d{4}-\\d{2}-\\d{3}$" },
    "reviewer": { "type": "string", "description": "裁决人（人工）" },
    "date": { "type": "string" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "verdict"],
        "properties": {
          "item_id": { "type": "string", "description": "对应 change-proposal 的 item_id" },
          "verdict": { "type": "string", "enum": ["approve", "reject", "request_research"] },
          "conditions": { "type": "string", "description": "可附条件" },
          "note": { "type": "string" }
        }
      }
    },
    "overall": { "type": "string", "description": "整体结论（人工）" }
  }
}
