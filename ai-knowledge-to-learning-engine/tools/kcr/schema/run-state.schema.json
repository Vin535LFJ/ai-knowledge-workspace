{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "P9 · run-state（轻量工作流状态机运行态）",
  "description": "reviews/P9-orchestrator-design.md §3 最小 schema 的实现扩展（P9.2：重试/断点恢复/防重复写入/来源追踪/人工跳过暂停）。产出方：tools/run_state.py。运行态落盘 .agent/runs/（D15：本地 only，gitignore）。硬规则（semantic_errors）：human_gate passed 必须有人工 approver+approved_at；进入 PUBLISH/FEEDBACK 必须 gate passed；kcr_substate APPROVED 及以后必须有 kcr_approved 人工过渡记录；done 只能出现在 FEEDBACK。",
  "type": "object",
  "required": ["schema_version", "run_id", "title", "phase", "status", "kcr_substate", "owner_agent", "dependencies", "write_paths", "artifacts", "human_gate", "phase_records", "transitions", "resume_point", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "type": "integer", "enum": [1] },
    "run_id": { "type": "string", "pattern": "^RUN-[A-Za-z0-9._-]+$" },
    "title": { "type": "string" },
    "phase": { "type": "string", "enum": ["INTAKE", "RESEARCH", "EVIDENCE", "ARCHITECT", "WRITE", "DESIGN", "PRACTICE", "REVIEW", "PUBLISH", "FEEDBACK"] },
    "status": { "type": "string", "enum": ["pending", "running", "paused", "done", "failed"] },
    "kcr_substate": { "type": ["string", "null"], "enum": ["PROPOSED", "REVIEWING", "APPROVED", "APPLIED", "VERIFIED", null] },
    "owner_agent": { "type": "string" },
    "dependencies": { "type": "array", "items": { "type": "string", "pattern": "^RUN-" } },
    "write_paths": { "type": "array", "items": { "type": "string" } },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["phase", "path", "hash", "kind", "registered_at"],
        "properties": {
          "phase": { "type": "string", "enum": ["INTAKE", "RESEARCH", "EVIDENCE", "ARCHITECT", "WRITE", "DESIGN", "PRACTICE", "REVIEW", "PUBLISH", "FEEDBACK"] },
          "path": { "type": "string" },
          "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": { "type": "string" },
          "registered_at": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "human_gate": {
      "type": ["object", "null"],
      "required": ["gate", "status", "approver", "approved_at"],
      "properties": {
        "gate": { "type": "string", "enum": ["G1", "G2", "G3"] },
        "status": { "type": "string", "enum": ["open", "passed"] },
        "approver": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"] }
      }
    },
    "phase_records": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "required": ["phase", "status", "entered_at", "completed_at", "failure_reason", "retry_count", "next_action"],
        "properties": {
          "phase": { "type": "string", "enum": ["INTAKE", "RESEARCH", "EVIDENCE", "ARCHITECT", "WRITE", "DESIGN", "PRACTICE", "REVIEW", "PUBLISH", "FEEDBACK"] },
          "status": { "type": "string", "enum": ["pending", "active", "done", "skipped"] },
          "entered_at": { "type": ["string", "null"] },
          "completed_at": { "type": ["string", "null"] },
          "failure_reason": { "type": ["string", "null"] },
          "retry_count": { "type": "integer" },
          "next_action": { "type": "string" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["at", "operator", "action", "detail", "reason"],
        "properties": {
          "at": { "type": "string" },
          "operator": { "type": "string" },
          "action": { "type": "string" },
          "detail": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "resume_point": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  }
}