{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/governance/schemas/decision.schema.json",
  "title": "Decision Record (MADR)",
  "description": "决策记录。区分 ADR / RFC-Proposal / Change Plan / Task / Execution Log；仅 ADR 用于架构决策。",
  "type": "object",
  "required": ["id", "title", "date", "status", "decision_type", "context", "decision", "rationale", "owner"],
  "properties": {
    "id": { "type": "string", "minLength": 1, "description": "例如 ADR-0001。" },
    "title": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "description": "YYYY-MM-DD。" },
    "decision_type": {
      "type": "string",
      "enum": ["adr", "rfc-proposal", "change-plan", "task", "execution-log"],
      "description": "类型区分：ADR 仅架构决策，普通任务不产生 ADR。"
    },
    "status": {
      "type": "string",
      "description": "ADR 用 proposed/accepted/deprecated/superseded；其余类型用各自生命周期。"
    },
    "context": { "type": "string", "description": "背景。" },
    "problem": { "type": "string", "description": "要解决的问题。" },
    "goals": { "type": "array", "items": { "type": "string" }, "default": [] },
    "constraints": { "type": "array", "items": { "type": "string" }, "default": [] },
    "options": { "type": "array", "items": { "type": "string" }, "default": [] },
    "comparison": { "type": "string", "description": "方案对比与权衡。" },
    "decision": { "type": "string", "minLength": 1, "description": "最终决定。" },
    "rationale": { "type": "string", "minLength": 1, "description": "决策理由。" },
    "consequences": { "type": "string", "description": "后果（正面与负面）。" },
    "supersession": {
      "type": "object",
      "description": "取代关系。",
      "properties": {
        "supersedes": { "type": ["string", "null"] },
        "superseded_by": { "type": ["string", "null"] }
      },
      "default": {}
    },
    "related_docs": { "type": "array", "items": { "type": "string" }, "default": [] },
    "owner": { "type": "string", "minLength": 1 },
    "human_approved": { "type": "boolean", "default": false, "description": "是否经人工批准；ADR 不得自动 accepted。" }
  },
  "additionalProperties": true
}
