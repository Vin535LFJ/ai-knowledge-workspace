{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.org/governance/schemas/project.schema.json",
  "title": "Project Governance Config",
  "description": "项目治理配置：定义项目身份、文档根、注册表路径与采用的生命周期。",
  "type": "object",
  "required": ["project_id", "name", "version"],
  "properties": {
    "project_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "owner": { "type": "string" },
    "doc_root": { "type": "string", "default": "." },
    "state_dir": { "type": "string", "default": ".governance" },
    "doc_levels": {
      "type": "array",
      "items": { "type": "string", "enum": ["L1", "L2", "L3"] },
      "default": ["L1", "L2", "L3"]
    },
    "lifecycles": {
      "type": "object",
      "description": "各文档类型采用的生命周期，避免强行合并为一条状态机。",
      "properties": {
        "general": { "type": "array", "items": { "type": "string" } },
        "change_proposal": { "type": "array", "items": { "type": "string" } },
        "adr": { "type": "array", "items": { "type": "string" } }
      }
    },
    "registries": {
      "type": "object",
      "properties": {
        "document": { "type": "string", "default": "document-registry.json" },
        "task": { "type": "string", "default": "task-registry.json" },
        "agent": { "type": "string", "default": "agent-registry.json" },
        "adr": { "type": "string", "default": "adr-index.json" }
      }
    },
    "adapters": {
      "type": "array",
      "items": { "type": "string" }
    },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" }
  },
  "additionalProperties": true
}
